# Copy this file to ".env" for local runs and fill in your own values.
# ".env" is listed in .gitignore. Never commit real secrets.
# On GitHub these come from repository Secrets, not from this file.

# Roblox Open Cloud API key (personal key, ad.campaign:read only)
ROBLOX_API_KEY=

# Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Chat(s) that receive the report: user ids, or negative ids for groups.
# Several chats: separate with commas, e.g. 111111111,222222222
TELEGRAM_CHAT_ID=

# Optional: list a group's ads account instead of your personal one
# ROBLOX_GROUP_ID=
